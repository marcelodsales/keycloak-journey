{
  "id": "mediterranean-finance",
  "realm": "mediterranean-finance",
  "displayName": "Mediterranean Finance",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "verifyEmail": false,
  "internationalizationEnabled": false,
  "defaultSignatureAlgorithm": "RS256",
  "loginTheme": "mediterranean-finance",
  "emailTheme": "mediterranean",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": [
    "jboss-logging",
    "mediterranean-event-logger"
  ],
  "enabledEventTypes": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "default-roles-mediterranean-finance",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        }
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false
      },
      {
        "name": "employee",
        "description": "Base role for all holding employees",
        "composite": false
      },
      {
        "name": "manager",
        "description": "Management role, includes employee permissions",
        "composite": true,
        "composites": {
          "realm": [
            "employee"
          ]
        }
      },
      {
        "name": "mfa-required",
        "description": "Users with this role are required to use multi-factor authentication",
        "composite": false
      }
    ],
    "client": {
      "account": [
        {
          "name": "manage-account",
          "description": "${role_manage-account}",
          "composite": true,
          "composites": {
            "client": {
              "account": [
                "manage-account-links"
              ]
            }
          }
        },
        {
          "name": "manage-account-links",
          "description": "${role_manage-account-links}",
          "composite": false
        },
        {
          "name": "view-profile",
          "description": "${role_view-profile}",
          "composite": false
        }
      ],
      "med-finance": [
        {
          "name": "report-viewer",
          "description": "Can view financial reports",
          "composite": false
        },
        {
          "name": "report-editor",
          "description": "Can edit financial reports",
          "composite": false
        },
        {
          "name": "invoice-writer",
          "description": "Can register invoices via cross-realm integration",
          "composite": false
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-mediterranean-finance",
    "description": "${role_default-roles}",
    "composite": true
  },
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Test",
      "email": "ana@mediterranean.com",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-mediterranean-finance",
        "employee",
        "mfa-required"
      ],
      "clientRoles": {
        "med-finance": [
          "report-viewer",
          "report-editor"
        ]
      },
      "attributes": {
        "department": [
          "Finance"
        ]
      }
    },
    {
      "username": "camila",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Camila",
      "lastName": "Test",
      "email": "camila@mediterranean.com",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-mediterranean-finance",
        "employee"
      ]
    },
    {
      "username": "service-account-med-digital-integration",
      "enabled": true,
      "emailVerified": false,
      "serviceAccountClientId": "med-digital-integration",
      "realmRoles": [
        "default-roles-mediterranean-finance"
      ],
      "clientRoles": {
        "med-finance": [
          "invoice-writer"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "med-finance",
      "name": "Mediterranean Finance",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret-jwt",
      "secret": "med-finance-secret",
      "consentRequired": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://finance.mediterranean.com/transfers",
        "https://finance.mediterranean.com/reconciliation",
        "https://finance.mediterranean.com/callback"
      ],
      "webOrigins": [
        "https://finance.mediterranean.com"
      ],
      "fullScopeAllowed": false,
      "attributes": {
        "post.logout.redirect.uris": "https://finance.mediterranean.com/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "fapi"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "med-digital-integration",
      "name": "Digital Integration Service Account",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "med-digital-integration-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "https://auth.mediterranean.com/realms/mediterranean",
      "name": "Holding Realm Broker Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "holding-broker-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://auth.mediterranean.com/realms/mediterranean/broker/finance-realm/endpoint/*"
      ],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "holding-realm",
      "displayName": "Mediterranean Holdings",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "Detect Existing Broker User",
      "config": {
        "syncMode": "IMPORT",
        "clientId": "https://auth.mediterranean.com/realms/mediterranean-finance",
        "clientSecret": "finance-broker-secret",
        "authorizationUrl": "https://auth.mediterranean.com/realms/mediterranean/protocol/openid-connect/auth",
        "tokenUrl": "https://auth.mediterranean.com/realms/mediterranean/protocol/openid-connect/token",
        "jwksUrl": "https://auth.mediterranean.com/realms/mediterranean/protocol/openid-connect/certs",
        "issuer": "https://auth.mediterranean.com/realms/mediterranean",
        "useJwksUrl": "true",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "browserFlow": "mediterranean-browser-stepup",
  "registrationFlow": "registration",
  "directGrantFlow": "direct grant",
  "resetCredentialsFlow": "reset credentials",
  "clientAuthenticationFlow": "clients",
  "authenticationFlows": [
    {
      "alias": "mediterranean-browser-stepup",
      "description": "Step-up authentication flow with LoA levels",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "mediterranean-stepup-forms"
        }
      ]
    },
    {
      "alias": "mediterranean-stepup-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "1st Condition Flow"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "2nd Condition Flow"
        }
      ]
    },
    {
      "alias": "1st Condition Flow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "Level 1",
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "2nd Condition Flow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "Level 2",
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "Detect Existing Broker User",
      "description": "First login flow for cross-realm brokering",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-detect-existing-broker-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "idp-auto-link",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "Level 1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "Level 2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    }
  ],
  "attributes": {
    "acr.loa.map": "{\"bronze\": 1, \"silver\": 2}"
  },
  "clientScopes": [
    {
      "name": "fapi",
      "description": "Marker scope for FAPI 1.0 Baseline client policy",
      "protocol": "openid-connect"
    }
  ],
  "clientPolicies": {
    "policies": [
      {
        "name": "fapi-finance",
        "description": "Enforce FAPI 1.0 Baseline on financial clients",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-scopes",
            "configuration": {
              "type": "Default",
              "scopes": ["fapi"]
            }
          }
        ],
        "profiles": ["fapi-1-baseline"]
      }
    ]
  }
}
