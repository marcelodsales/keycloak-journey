{
  "realm": "mediterranean",
  "displayName": "Mediterranean",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Base role for all holding employees" },
      {
        "name": "manager",
        "description": "Management role across the holding",
        "composite": true,
        "composites": { "realm": [ "employee" ] }
      },
      { "name": "admin", "description": "Administrative role across the holding" }
    ],
    "client": {
      "med-digital-frontend": [
        { "name": "catalog-editor", "description": "Can edit the product catalog" },
        { "name": "price-manager", "description": "Can manage product prices" }
      ],
      "med-finance": [
        { "name": "report-viewer", "description": "Can view financial reports" },
        { "name": "report-editor", "description": "Can edit financial reports" }
      ],
      "med-logistics": [
        { "name": "shipment-tracker", "description": "Can track shipments" },
        { "name": "cost-analyst", "description": "Can view cost reports" }
      ],
      "med-health": [
        { "name": "doctor", "description": "Medical doctor with access to medical records" },
        { "name": "nurse", "description": "Nurse with access to appointments" },
        { "name": "clinic-admin", "description": "Clinic administrator with access to staff schedules" }
      ]
    }
  },
  "groups": [
    {
      "name": "mediterranean",
      "subGroups": [
        {
          "name": "digital",
          "subGroups": [ { "name": "engineering" }, { "name": "operations" } ]
        },
        {
          "name": "finance",
          "subGroups": [ { "name": "analysts" }, { "name": "managers" } ]
        },
        {
          "name": "logistics",
          "subGroups": [ { "name": "warehouse" }, { "name": "partners" }, { "name": "managers" } ]
        },
        { "name": "corporate" },
        {
          "name": "health",
          "subGroups": [ { "name": "doctors" }, { "name": "nurses" }, { "name": "admin" } ]
        }
      ]
    }
  ],
  "defaultGroups": [ "/mediterranean" ],
  "users": [
    {
      "username": "daniel",
      "enabled": true, "emailVerified": true,
      "firstName": "Daniel", "lastName": "Test",
      "email": "daniel@mediterranean.com",
      "credentials": [ { "type": "password", "value": "password123", "temporary": false } ],
      "realmRoles": [ "default-roles-mediterranean", "employee" ],
      "clientRoles": { "med-digital-frontend": [ "catalog-editor", "price-manager" ] },
      "groups": [ "/mediterranean/digital/engineering" ]
    },
    {
      "username": "camila",
      "enabled": true, "emailVerified": true,
      "firstName": "Camila", "lastName": "Test",
      "email": "camila@mediterranean.com",
      "credentials": [ { "type": "password", "value": "password123", "temporary": false } ],
      "realmRoles": [ "default-roles-mediterranean", "employee" ],
      "clientRoles": { "med-finance": [ "report-viewer", "report-editor" ] },
      "groups": [ "/mediterranean/finance/analysts" ]
    },
    {
      "username": "sofia",
      "enabled": true, "emailVerified": true,
      "firstName": "Sofia", "lastName": "Test",
      "email": "sofia@mediterranean.com",
      "credentials": [ { "type": "password", "value": "password123", "temporary": false } ],
      "realmRoles": [ "default-roles-mediterranean", "employee" ],
      "clientRoles": { "med-logistics": [ "shipment-tracker" ] },
      "groups": [ "/mediterranean/logistics/warehouse" ]
    },
    {
      "username": "ana",
      "enabled": true, "emailVerified": true,
      "firstName": "Ana", "lastName": "Test",
      "email": "ana@mediterranean.com",
      "credentials": [ { "type": "password", "value": "password123", "temporary": false } ],
      "realmRoles": [ "default-roles-mediterranean", "employee", "manager" ],
      "clientRoles": { "med-finance": [ "report-viewer" ] },
      "groups": [ "/mediterranean/digital/operations" ]
    },
    {
      "username": "sara",
      "enabled": true, "emailVerified": true,
      "firstName": "Sara", "lastName": "Test",
      "email": "sara@mediterranean.com",
      "credentials": [ { "type": "password", "value": "password123", "temporary": false } ],
      "realmRoles": [ "default-roles-mediterranean", "employee" ],
      "clientRoles": { "med-health": [ "doctor", "clinic-admin" ] },
      "groups": [ "/mediterranean/health/doctors" ]
    },
    {
      "username": "service-account-med-digital-backend",
      "enabled": true,
      "serviceAccountClientId": "med-digital-backend",
      "realmRoles": [ "default-roles-mediterranean" ],
      "clientRoles": { "med-finance": [ "report-viewer" ] }
    }
  ],
  "clients": [
    {
      "clientId": "med-digital-frontend",
      "name": "Mediterranean Digital Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [ "http://localhost:3000/*" ],
      "webOrigins": [ "http://localhost:3000" ],
      "fullScopeAllowed": false,
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "med-digital-backend",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "med-digital-backend",
      "name": "Mediterranean Digital Backend",
      "enabled": true,
      "publicClient": false,
      "secret": "med-digital-backend-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "med-finance",
      "name": "Mediterranean Finance",
      "enabled": true,
      "publicClient": false,
      "secret": "med-finance-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [ "http://localhost:5001/auth" ],
      "webOrigins": [ "http://localhost:5001" ]
    },
    {
      "clientId": "med-logistics",
      "name": "Mediterranean Logistics",
      "enabled": true,
      "publicClient": false,
      "secret": "med-logistics-secret",
      "protocol": "saml",
      "frontchannelLogout": true,
      "redirectUris": [ "http://localhost:8082/login/saml2/sso/keycloak" ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.force.post.binding": "true",
        "saml_name_id_format": "email",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml_assertion_consumer_url_post": "http://localhost:8082/login/saml2/sso/keycloak"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "config": {
            "attribute.nameformat": "Basic",
            "full.path": "true",
            "attribute.name": "member-of",
            "single": "true"
          }
        }
      ]
    },
    {
      "clientId": "med-health",
      "name": "Mediterranean Health",
      "enabled": true,
      "publicClient": false,
      "secret": "med-health-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [ "http://localhost:5002/*" ],
      "webOrigins": [ "http://localhost:5002" ]
    }
  ]
}
