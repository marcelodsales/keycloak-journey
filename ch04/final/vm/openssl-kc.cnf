[req]
default_bits       = 2048
prompt             = no
distinguished_name = dn
req_extensions     = v3_req

[dn]
CN = kc-digital.mediterranean.internal
O  = Mediterranean Holdings
OU = Platform Engineering

[v3_req]
subjectAltName = @alt_names
keyUsage       = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = kc-digital.mediterranean.internal
DNS.2 = kc-digital
IP.1  = 10.0.1.10
