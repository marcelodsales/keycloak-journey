{
  "id": "mediterranean",
  "realm": "mediterranean",
  "displayName": "Mediterranean",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "verifyEmail": false,
  "internationalizationEnabled": false,
  "defaultSignatureAlgorithm": "RS256",
  "loginTheme": "mediterranean",
  "emailTheme": "mediterranean",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": [
    "jboss-logging",
    "mediterranean-event-logger"
  ],
  "enabledEventTypes": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "organizationsEnabled": true,
  "organizations": [
    {
      "name": "Mediterranean Digital",
      "alias": "med-digital",
      "enabled": true,
      "domains": [
        {
          "name": "digital.mediterranean.com",
          "verified": true
        }
      ]
    },
    {
      "name": "Mediterranean Logistics",
      "alias": "med-logistics",
      "enabled": true,
      "domains": [
        {
          "name": "logistics.mediterranean.com",
          "verified": true
        }
      ]
    },
    {
      "name": "Mediterranean Corporate",
      "alias": "med-corporate",
      "enabled": true,
      "domains": [
        {
          "name": "corporate.mediterranean.com",
          "verified": true
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "default-roles-mediterranean",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        }
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false
      },
      {
        "name": "employee",
        "description": "Base role for all holding employees",
        "composite": false
      },
      {
        "name": "manager",
        "description": "Management role, includes employee permissions",
        "composite": true,
        "composites": {
          "realm": [
            "employee"
          ]
        }
      },
      {
        "name": "admin",
        "description": "Administrative role across the holding",
        "composite": false
      },
      {
        "name": "mfa-required",
        "description": "Users with this role are required to use multi-factor authentication",
        "composite": false
      }
    ],
    "client": {
      "account": [
        {
          "name": "manage-account",
          "description": "${role_manage-account}",
          "composite": true,
          "composites": {
            "client": {
              "account": [
                "manage-account-links"
              ]
            }
          }
        },
        {
          "name": "manage-account-links",
          "description": "${role_manage-account-links}",
          "composite": false
        },
        {
          "name": "view-profile",
          "description": "${role_view-profile}",
          "composite": false
        }
      ],
      "digital-frontend": [
        {
          "name": "catalog-editor",
          "description": "Can edit the product catalog",
          "composite": false
        },
        {
          "name": "price-manager",
          "description": "Can manage product prices",
          "composite": false
        }
      ],
      "med-logistics": [
        {
          "name": "shipment-tracker",
          "description": "Can track shipments",
          "composite": false
        },
        {
          "name": "cost-analyst",
          "description": "Can view cost reports",
          "composite": false
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-mediterranean",
    "description": "${role_default-roles}",
    "composite": true
  },
  "groups": [
    {
      "name": "mediterranean",
      "path": "/mediterranean",
      "subGroups": [
        {
          "name": "digital",
          "path": "/mediterranean/digital",
          "subGroups": [
            {
              "name": "engineering",
              "path": "/mediterranean/digital/engineering"
            },
            {
              "name": "operations",
              "path": "/mediterranean/digital/operations"
            }
          ]
        },
        {
          "name": "logistics",
          "path": "/mediterranean/logistics",
          "subGroups": [
            {
              "name": "warehouse",
              "path": "/mediterranean/logistics/warehouse"
