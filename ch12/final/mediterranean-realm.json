            "type": "urn:med-finance:report",
            "uris": [
              "/api/reports/compensation-accrual"
            ],
            "scopes": [
              {
                "name": "view"
              }
            ],
            "attributes": {
              "department": [
                "Corporate"
              ]
            }
          }
        ],
        "scopes": [
          {
            "name": "view"
          }
        ],
        "policies": [
          {
            "name": "require-employee",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"employee\"}]"
            }
          },
          {
            "name": "business-hours-only",
            "type": "time",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "hour": "9",
              "hourEnd": "17"
            }
          },
          {
            "name": "view-compensation-accrual",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"compensation-accrual\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"require-employee\",\"business-hours-only\"]"
            }
          }
        ]
      },
